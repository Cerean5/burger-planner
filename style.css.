
:root {
  --green: #16a34a;
  --dark: #15351f;
  --cream: #f7f8f2;
  --white: #fff;
  --text: #263329;
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  background: var(--cream);
  color: var(--text);
  font-family: Arial, Helvetica, sans-serif;
  line-height: 1.6;
}
a { color: inherit; }
.header {
  background: white;
  padding: 14px 6%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 2px 12px #0000000d;
}
.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
  font-size: 1.2rem;
  font-weight: 800;
  color: var(--dark);
}
.header nav { display: flex; gap: 22px; }
.header nav a { text-decoration: none; font-weight: 700; }
.header nav a:hover { color: var(--green); }
.menu-button { display: none; }
.hero {
  min-height: 420px;
  display: flex;
  align-items: center;
  padding: 60px 8%;
  background: linear-gradient(90deg,#102c1aeb,#102c1a65),
    url("https://images.unsplash.com/photo-1520072959219-c595dc870360?auto=format&fit=crop&w=1800&q=85") center/cover;
  color: white;
}
.hero-content { max-width: 650px; }
.hero h1 { font-size: clamp(2.6rem,7vw,5rem); line-height: 1.05; margin: 10px 0 20px; }
.hero p:not(.eyebrow) { font-size: 1.15rem; max-width: 560px; }
.eyebrow { color: var(--green); font-weight: 800; letter-spacing: 2px; font-size: .8rem; }
.hero .eyebrow { color: #a7f3b7; }
.button {
  display: inline-block;
  margin-top: 14px;
  padding: 12px 22px;
  border: 0;
  border-radius: 8px;
  background: var(--green);
  color: white;
  font-size: 1rem;
  font-weight: 700;
  text-decoration: none;
  cursor: pointer;
}
.button:hover { filter: brightness(.92); }
.button.secondary { background: var(--dark); }
.section { max-width: 1180px; margin: auto; padding: 65px 24px; }
.section h2 { color: var(--dark); font-size: clamp(2rem,4vw,3rem); margin: 0; }
.filters { display: flex; gap: 12px; margin: 25px 0; }
input, select {
  min-width: 0;
  padding: 12px;
  border: 1px solid #d4ddd4;
  border-radius: 8px;
  background: white;
  font: inherit;
}
#search { flex: 1; }
.grid, .simple-grid {
  display: grid;
  grid-template-columns: repeat(3,minmax(0,1fr));
  gap: 20px;
}
.recipe-card, .mini-card {
  overflow: hidden;
  background: white;
  border-radius: 14px;
  border: 1px solid #e5e9e2;
  box-shadow: 0 5px 18px #18351a0b;
}
.recipe-card { display: flex; flex-direction: column; }
.recipe-card .card-body, .mini-card { padding: 20px; }
.recipe-card h3, .mini-card h3 { color: var(--dark); margin: 5px 0; }
.recipe-card p, .mini-card p { color: #58655b; }
.recipe-card .button { align-self: flex-start; margin-top: auto; }
.recipe-card .card-body { display: flex; flex-direction: column; flex: 1; }
.recipe-photo {
  min-height: 155px;
  display: grid;
  place-items: center;
  background: #e5f4e5;
  font-size: 4rem;
}
.feature { max-width: none; padding-left: max(24px,calc((100% - 1132px)/2)); padding-right: max(24px,calc((100% - 1132px)/2)); background: #edf5e9; }
.plan-list { margin: 20px 0; }
.plan-item { padding: 14px 0; display: flex; align-items: center; justify-content: space-between; gap: 12px; border-bottom: 1px solid #d4dfd1; }
.plan-item button { border: 1px solid #d0d8ce; background: white; border-radius: 6px; padding: 7px 10px; cursor: pointer; }
.mini-card span { font-size: 2.5rem; }
footer { text-align: center; padding: 35px 20px; background: var(--dark); color: white; }
footer img { vertical-align: middle; }
footer p { margin: 5px; }
@media (max-width: 760px) {
  .header { flex-wrap: wrap; }
  .menu-button { display: block; background: none; border: 0; font-size: 1.5rem; cursor: pointer; }
  .header nav { display: none; flex-basis: 100%; flex-direction: column; gap: 10px; padding: 10px 0; }
  .header nav.open { display: flex; }
  .grid, .simple-grid { grid-template-columns: 1fr; }
  .hero { min-height: 380px; padding: 45px 24px; }
  .filters { flex-direction: column; }
}
